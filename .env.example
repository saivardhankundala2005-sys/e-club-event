# Supabase Public Configuration (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (Used for admin actions / seeds)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Next.js App URL (defaults to http://localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# TEMPORARY: comma-separated allowlist of non-@student.nitw.ac.in staff test
# account emails that may bypass the strict staff domain check. Remove once
# test accounts are migrated to real institute emails. Leave empty in production.
STAFF_TEST_EMAIL_ALLOWLIST=
